# Anthropic
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5-5

# Linq (iMessage)
LINQ_API_V3_API_KEY=
LINQ_WEBHOOK_SECRET=          # whsec_... returned when the webhook subscription is created
OWNER_HANDLE=                 # your iMessage handle(s), comma-separated: Apple ID email and/or E.164 phone — only these get replies

# HydraDB
HYDRA_DB_API_KEY=
HYDRA_DB_DATABASE=
HYDRA_DB_COLLECTION=          # optional; collection where the agent's own memories are written
HYDRA_DB_SEARCH_COLLECTIONS=gmail,google_drive

# Composio (Google Docs + Gmail)
COMPOSIO_API_KEY=
COMPOSIO_USER_ID=             # the Composio user id that owns your Gmail/Docs connections

# Fallback if Calendly isn't found in memory
CALENDLY_URL=

# Upstash Redis (optional locally — falls back to in-memory)
KV_REST_API_URL=
KV_REST_API_TOKEN=
